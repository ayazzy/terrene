# Development only: API must bind to loopback. Never enable bypass on a hosted service.
CRC_ENV=development
CRC_API_URL=http://127.0.0.1:8000
# Optional preferred local PostGIS, after docker compose up -d:
# DATABASE_URL=postgresql+psycopg://crc:crc_local_only@127.0.0.1:54329/crc
# If omitted, local development uses SQLite + server-side Shapely, with local objects.
CRC_DATA_DIR=data
CRC_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# Hosted mode requires these (server only):
SUPABASE_URL=
SUPABASE_ANON_KEY=
R2_BUCKET=
R2_ENDPOINT=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# Required for production: hosted MapLibre vector-style JSON URL (build-time).
# Local development uses OpenFreeMap Dark when this is omitted; its public
# service has no SLA and is not the production default.
NEXT_PUBLIC_BASEMAP_STYLE_URL=
# Legacy raster fallback only (build-time):
# NEXT_PUBLIC_BASEMAP_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png

# Real environmental acquisition is enabled by default for non-synthetic jobs.
# Offline regression/testing only; this pins unavailable acquisition, never fake inputs:
# CRC_ENVIRONMENT_ACQUISITION=disabled
# Optional cache prewarm: .venv/bin/python scripts/fetch_open_rivers.py
